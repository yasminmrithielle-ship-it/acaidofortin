{
  "name": "acai-do-fortin",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "mobile": "npm run dev --workspace @fortin/mobile",
    "admin": "npm run dev --workspace @fortin/admin",
    "api": "npm run dev --workspace @fortin/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "node scripts/build-web.mjs",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "docker:hostinger": "docker compose --env-file .env.hostinger -f docker-compose.hostinger.yml up -d --build",
    "docker:hostinger:down": "docker compose --env-file .env.hostinger -f docker-compose.hostinger.yml down",
    "prisma:generate": "npm run prisma:generate --workspace @fortin/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @fortin/api",
    "prisma:push": "npm run prisma:push --workspace @fortin/api",
    "prisma:seed": "npm run prisma:seed --workspace @fortin/api"
  }
}
